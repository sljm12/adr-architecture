{
  "name": "adr-diagram",
  "private": true,
  "scripts": {
    "build": "npm run build:api && npm run build --prefix frontend && npm run build --prefix cli",
    "build:api": "npm run build --prefix shared && npm run build --prefix backend && esbuild backend/src/server.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=backend/build/server.mjs",
    "cli": "tsx cli/src/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@xyflow/react": "^12.8.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "jszip": "^3.10.2",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
